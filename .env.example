# ==============================================================================
# Drinks System - Variables de Entorno
# ==============================================================================
# Copiar este archivo como .env y ajustar los valores según el entorno.
# NUNCA commitear el archivo .env (contiene secretos).
# ==============================================================================

# ------------------------------------------------------------------------------
# Base de Datos PostgreSQL
# ------------------------------------------------------------------------------
DB_HOST=postgres-drinks
DB_PORT=5432
DB_NAME=drinks_db
DB_ADMIN_USER=drinks_admin
DB_ADMIN_PASSWORD=change_me_admin_prod

# ------------------------------------------------------------------------------
# Usuarios por servicio (permisos limitados por esquema)
# Cada servicio usa un usuario con acceso restringido a su propio esquema.
# ------------------------------------------------------------------------------
ACCESS_DB_USER=access_user
ACCESS_DB_PASSWORD=change_me_access
SALES_DB_USER=sales_user
SALES_DB_PASSWORD=change_me_sales
INVENTORY_DB_USER=inventory_user
INVENTORY_DB_PASSWORD=change_me_inventory
REPORTING_DB_USER=reporting_user
REPORTING_DB_PASSWORD=change_me_reporting

# ------------------------------------------------------------------------------
# Seguridad JWT
# ------------------------------------------------------------------------------
# Clave secreta para firmar tokens HMAC-SHA256 (mínimo 32 caracteres)
JWT_SECRET=your-256-bit-secret-key-must-be-at-least-32-characters-long-for-hmac
# Tiempo de vida del access token en minutos
JWT_EXPIRATION_MINUTES=15
# Tiempo de vida del refresh token en días
REFRESH_TOKEN_EXPIRATION_DAYS=7

# ------------------------------------------------------------------------------
# Connection Pool (HikariCP)
# ------------------------------------------------------------------------------
HIKARI_MAX_POOL_SIZE=10
HIKARI_MIN_IDLE=5

# ------------------------------------------------------------------------------
# API Gateway / CORS
# ------------------------------------------------------------------------------
# Origen permitido para solicitudes CORS (URL del frontend)
FRONTEND_ORIGIN=http://localhost:4200

# ------------------------------------------------------------------------------
# URLs Inter-Servicio (comunicación interna entre microservicios)
# En Docker, usar los nombres de servicio definidos en docker-compose.yml
# En desarrollo local, usar localhost con los puertos correspondientes
# ------------------------------------------------------------------------------
ACCESS_SERVICE_URL=http://access-service:8081
INVENTORY_SERVICE_URL=http://inventory-service:8083
